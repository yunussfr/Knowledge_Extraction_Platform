# Application
APP_ENV=development
LOG_LEVEL=INFO

# Data source provider: mock keeps the pipeline offline; firecrawl enables live discovery.
DATA_SOURCE_PROVIDER=mock

# Firecrawl is responsible for real web discovery/search.
FIRECRAWL_API_KEY=
FIRECRAWL_API_URL=https://api.firecrawl.dev
# Crawl4AI is responsible for page acquisition after source selection.
CRAWL4AI_HEADLESS=true
CRAWL4AI_PAGE_TIMEOUT_MS=60000
CRAWL4AI_CACHE_MODE=enabled
CRAWL4AI_PRUNING_THRESHOLD=0.45
CRAWL4AI_PREVIEW_MAX_WORDS=400
CRAWL4AI_BATCH_CONCURRENCY=4
CRAWL4AI_BATCH_DELAY_SECONDS=0.25
CONTENT_MIN_WORDS=30
# Crawl4AI creates a .crawl4ai cache below this directory. The default is the
# repository-local, gitignored .runtime directory.
CRAWL4_AI_BASE_DIRECTORY=./.runtime
FIRECRAWL_SEARCH_LIMIT=10
FIRECRAWL_REQUEST_TIMEOUT=60
FIRECRAWL_MAX_RETRIES=2

# Groq is responsible for planning, source evaluation, schema design, and extraction.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0
GROQ_REQUEST_TIMEOUT=60
GROQ_MAX_RETRIES=2
# auto tries strict JSON Schema and falls back only when the model reports that
# the response format is unsupported. Use json_schema to require strict mode or
# json_object to disable the strict attempt explicitly.
GROQ_STRUCTURED_OUTPUT_MODE=auto
RUN_INTEGRATION_TESTS=false
# Opt-in local-fixture browser test; it never requests an external page.
RUN_CRAWL4AI_BROWSER_TESTS=false

# Defaults for research and schema approval.
DEFAULT_MAX_SEARCH_QUERIES=10
DEFAULT_MAX_SOURCES=20
REQUIRE_SCHEMA_APPROVAL=true

# Evidence-support quality gate.
MINIMUM_CONFIDENCE=0.70
# Phase 18 final acceptance uses evidence/provenance/source/schema components,
# never extractor confidence. Partially supported records are rejected by default.
MINIMUM_EVIDENCE_QUALITY=0.70
ALLOW_PARTIALLY_SUPPORTED=false
LOW_CONFIDENCE_ACTION=reject
MAX_EXTRACTION_RETRIES=3
VALIDATE_STRUCTURED_OUTPUT=true

# Safe defaults for long source documents. Per-domain request settings override these values.
CHUNKING_ENABLED=true
CHUNK_TARGET_TOKENS=6000
CHUNK_OVERLAP_TOKENS=300

# Final dataset output.
OUTPUT_DIRECTORY=./knowledge/datasets
DEFAULT_OUTPUT_FORMAT=json
SAVE_RAW_CONTENT=false
SAVE_CLEAN_CONTENT=false
