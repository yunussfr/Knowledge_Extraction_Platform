  {
    "data": {
      "dish_name": "Kömbe",
      "dish_description": "Kömbe, Malatya yöresine ait bir yemektir. Yağ ve halka şeklinde doğranmış soğan ilave edilerek kızartılır, sulandırılmış salçayla da bir iki kez karıştırıldıktan sonra üzerine bol miktarda su ilave edilir, pişirmeye yakın tuz atılır.",
      "ingredients": [
        "1/2 ekmek mayası veya 1/2 kibrit kutusu kadar pak maya",
        "1/2 kg. kuşbaşı et",
        "3-4 yemek kaşığı tereyağı",
        "Tuz - susam -1-1,5 kg. un",
        "un",
        "yaş maya",
        "sıvı yağ",
        "tuz",
        "ılık su",
        "peynir",
        "haşlanmış patates",
        "maydanoz",
        "karabiber",
        "pul biber",
        "reyhan"
      ],
      "cooking_technique": "Pişirmeye yakın tuz atılır. Pişen ete ayıklanmış, yıkanmış pirinç ilâve edilir. Pirinçler uzayıncaya kadar pişirilir.",
      "dessert_specialty": false,
      "regional_ingredients": [
        "kuşbaşı et",
        "tereyağı",
        "tuz",
        "susam",
        "un",
        "Malatya peyniri"
      ]
    },
